# Boards running this MicroPython debugger firmware, which presents a second
# CDC interface for the debug channel.
#
# One line per supported board.  Keep this in step with KNOWN_DEVICES in
# src/protocol.ts: a board the extension can find on Windows but cannot open on
# Linux is the same failure to the user, and harder to diagnose.
#
# Install with:
#     sudo cp 99-sitcore-micropython.rules /etc/udev/rules.d/
#     sudo udevadm control --reload-rules && sudo udevadm trigger
#
# Two problems this solves, both of which look like "the extension cannot find
# or open the board":
#
#   1. Permissions. /dev/ttyACM* belongs to root:dialout, and a desktop user is
#      often not in that group. TAG+="uaccess" grants the locally logged-in user
#      access without any group change; MODE="0666" is the fallback for systems
#      without logind.
#
#   2. ModemManager. On most desktop distributions it probes every new ttyACM
#      device and sends AT commands at it for the first several seconds. On a
#      debug channel that is line noise: the first connection after plugging in
#      fails or behaves strangely, then recovers, which is a miserable thing to
#      diagnose. ID_MM_DEVICE_IGNORE tells it to leave this device alone.

# GHI Electronics SITCore SC13xxx, dual CDC (VCP+VCP)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1b9f", ATTRS{idProduct}=="f105", MODE="0666", TAG+="uaccess", ENV{ID_MM_DEVICE_IGNORE}="1"

# Raspberry Pi Pico / Pico 2.  Same VID/PID as stock MicroPython, which is
# deliberate (see 12.2): stock presents one CDC and simply has no debug
# channel, so matching it here costs nothing and keeps the board a drop-in.
SUBSYSTEM=="tty", ATTRS{idVendor}=="2e8a", ATTRS{idProduct}=="0005", MODE="0666", TAG+="uaccess", ENV{ID_MM_DEVICE_IGNORE}="1"

# Adafruit QT Py RP2040.  Boards that carry their own USB identity need their
# own line -- many rp2 boards override MICROPY_HW_USB_VID/PID, so this list
# grows with the supported-board list rather than by chip family.
SUBSYSTEM=="tty", ATTRS{idVendor}=="239a", ATTRS{idProduct}=="80f8", MODE="0666", TAG+="uaccess", ENV{ID_MM_DEVICE_IGNORE}="1"

# ESP32-S2 / S3 with the debugger.  PID 0x4002 is 0x4000 | CDC count, so a
# two-CDC build is distinct from stock MicroPython (0x4001) automatically.
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="4002", MODE="0666", TAG+="uaccess", ENV{ID_MM_DEVICE_IGNORE}="1"
