.vscode/**
src/**
test/**
examples/**
**/*.ts
**/*.map
tsconfig.json
.gitignore

# Internal material -- a .vsix is a zip, so anything listed here would be
# readable by every customer who installs the extension.
micropython_debugger.md
tools/**
build-extension.bat
install_vsix.bat
*.vsix

# The 2375x1543 master. images/screenshot.jpg is the resized copy the README
# points at; this original would only ever bloat the .vsix.
demo.jpg

# Firmware is fetched from the raw GitHub URL at run time (see
# `micropython-debugger.firmwareManifestUrl` in package.json), so the local
# copies here would only bloat the .vsix without ever being read.
docs/**
micropython_firmware.json
