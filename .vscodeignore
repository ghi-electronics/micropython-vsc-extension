.vscode/**
src/**
test/**
examples/**
**/*.ts
**/*.map
tsconfig.json
.gitignore

# Internal material -- kept OUT of the .vsix. A .vsix is a plain zip, so
# anything left in would be readable by every customer who installs the
# extension. These files are for the team only.
micropython_debugger.md
tools/**
build-extension.bat
install_vsix.bat
*.vsix

# Firmware is fetched from the raw GitHub URL at run time (see
# `micropython-debugger.firmwareManifestUrl` in package.json), so the local
# copies here would only bloat the .vsix without ever being read.
docs/**
micropython_firmware.json
